# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:phoenix_skin":1}},lore=['{"text":"RARE | ARMOR | Level I / III","color":"aqua","italic":false}','{"text":"Periodically grants brief Fire Resistance.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:phoenix_skin":2}},lore=['{"text":"RARE | ARMOR | Level II / III","color":"aqua","italic":false}','{"text":"Periodically grants brief Fire Resistance.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:phoenix_skin":3}},lore=['{"text":"RARE | ARMOR | Level III / III","color":"aqua","italic":false}','{"text":"Periodically grants brief Fire Resistance.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Phoenix Skin I (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Phoenix Skin II (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Phoenix Skin III (rare).","color":"aqua"}
