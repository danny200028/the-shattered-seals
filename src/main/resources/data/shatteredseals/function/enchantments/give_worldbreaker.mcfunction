# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:worldbreaker":1}},lore=['{"text":"LEGENDARY | PICKAXE | Level I / III","color":"gold","italic":false}','{"text":"Greatly increases mining speed.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:worldbreaker":2}},lore=['{"text":"LEGENDARY | PICKAXE | Level II / III","color":"gold","italic":false}','{"text":"Greatly increases mining speed.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:worldbreaker":3}},lore=['{"text":"LEGENDARY | PICKAXE | Level III / III","color":"gold","italic":false}','{"text":"Greatly increases mining speed.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Worldbreaker I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Worldbreaker II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Worldbreaker III (legendary).","color":"gold"}
