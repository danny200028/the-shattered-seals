# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:deep_miner":1}},lore=['{"text":"COMMON | PICKAXE | Level I / III","color":"gray","italic":false}','{"text":"Improves mining speed with a pickaxe.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:deep_miner":2}},lore=['{"text":"COMMON | PICKAXE | Level II / III","color":"gray","italic":false}','{"text":"Improves mining speed with a pickaxe.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:deep_miner":3}},lore=['{"text":"COMMON | PICKAXE | Level III / III","color":"gray","italic":false}','{"text":"Improves mining speed with a pickaxe.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Deep Miner I (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Deep Miner II (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Deep Miner III (common).","color":"gray"}
