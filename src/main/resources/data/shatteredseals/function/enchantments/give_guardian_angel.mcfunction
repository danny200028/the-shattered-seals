# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:guardian_angel":1}},lore=['{"text":"LEGENDARY | ARMOR | Level I / III","color":"gold","italic":false}','{"text":"Periodically grants a brief absorption shield.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:guardian_angel":2}},lore=['{"text":"LEGENDARY | ARMOR | Level II / III","color":"gold","italic":false}','{"text":"Periodically grants a brief absorption shield.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:guardian_angel":3}},lore=['{"text":"LEGENDARY | ARMOR | Level III / III","color":"gold","italic":false}','{"text":"Periodically grants a brief absorption shield.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Guardian Angel I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Guardian Angel II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Guardian Angel III (legendary).","color":"gold"}
