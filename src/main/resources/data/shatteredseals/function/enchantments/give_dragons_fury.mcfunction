# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:dragons_fury":1}},lore=['{"text":"LEGENDARY | SWORD | Level I / III","color":"gold","italic":false}','{"text":"Occasionally ignites struck enemies for longer.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:dragons_fury":2}},lore=['{"text":"LEGENDARY | SWORD | Level II / III","color":"gold","italic":false}','{"text":"Occasionally ignites struck enemies for longer.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:dragons_fury":3}},lore=['{"text":"LEGENDARY | SWORD | Level III / III","color":"gold","italic":false}','{"text":"Occasionally ignites struck enemies for longer.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Dragon's Fury I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Dragon's Fury II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Dragon's Fury III (legendary).","color":"gold"}
