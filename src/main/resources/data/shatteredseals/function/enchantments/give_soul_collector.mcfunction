# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_collector":1}},lore=['{"text":"RARE | SWORD | Level I / III","color":"aqua","italic":false}','{"text":"Adds experience from eligible mob kills.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_collector":2}},lore=['{"text":"RARE | SWORD | Level II / III","color":"aqua","italic":false}','{"text":"Adds experience from eligible mob kills.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_collector":3}},lore=['{"text":"RARE | SWORD | Level III / III","color":"aqua","italic":false}','{"text":"Adds experience from eligible mob kills.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Soul Collector I (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Soul Collector II (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Soul Collector III (rare).","color":"aqua"}
