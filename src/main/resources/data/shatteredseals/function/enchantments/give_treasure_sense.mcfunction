# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:treasure_sense":1}},lore=['{"text":"COMMON | TOOL | Level I / III","color":"gray","italic":false}','{"text":"Adds mining XP from blocks which award XP.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:treasure_sense":2}},lore=['{"text":"COMMON | TOOL | Level II / III","color":"gray","italic":false}','{"text":"Adds mining XP from blocks which award XP.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:treasure_sense":3}},lore=['{"text":"COMMON | TOOL | Level III / III","color":"gray","italic":false}','{"text":"Adds mining XP from blocks which award XP.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Treasure Sense I (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Treasure Sense II (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Treasure Sense III (common).","color":"gray"}
