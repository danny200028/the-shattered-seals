# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_reaper":1}},lore=['{"text":"LEGENDARY | SWORD | Level I / III","color":"gold","italic":false}','{"text":"Occasionally grants Regeneration on a hit.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_reaper":2}},lore=['{"text":"LEGENDARY | SWORD | Level II / III","color":"gold","italic":false}','{"text":"Occasionally grants Regeneration on a hit.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:soul_reaper":3}},lore=['{"text":"LEGENDARY | SWORD | Level III / III","color":"gold","italic":false}','{"text":"Occasionally grants Regeneration on a hit.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Soul Reaper I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Soul Reaper II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Soul Reaper III (legendary).","color":"gold"}
