# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:vampiric_edge":1}},lore=['{"text":"RARE | SWORD | Level I / III","color":"aqua","italic":false}','{"text":"Occasionally grants Regeneration after a melee hit.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:vampiric_edge":2}},lore=['{"text":"RARE | SWORD | Level II / III","color":"aqua","italic":false}','{"text":"Occasionally grants Regeneration after a melee hit.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:vampiric_edge":3}},lore=['{"text":"RARE | SWORD | Level III / III","color":"aqua","italic":false}','{"text":"Occasionally grants Regeneration after a melee hit.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Vampiric Edge I (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Vampiric Edge II (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Vampiric Edge III (rare).","color":"aqua"}
