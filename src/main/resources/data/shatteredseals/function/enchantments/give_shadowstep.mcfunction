# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:shadowstep":1}},lore=['{"text":"RARE | FEET | Level I / III","color":"aqua","italic":false}','{"text":"Increases movement speed while equipped.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:shadowstep":2}},lore=['{"text":"RARE | FEET | Level II / III","color":"aqua","italic":false}','{"text":"Increases movement speed while equipped.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:shadowstep":3}},lore=['{"text":"RARE | FEET | Level III / III","color":"aqua","italic":false}','{"text":"Increases movement speed while equipped.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Shadowstep I (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Shadowstep II (rare).","color":"aqua"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Shadowstep III (rare).","color":"aqua"}
