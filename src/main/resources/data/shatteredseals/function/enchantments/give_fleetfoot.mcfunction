# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:fleetfoot":1}},lore=['{"text":"COMMON | FEET | Level I / III","color":"gray","italic":false}','{"text":"Increases movement speed.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:fleetfoot":2}},lore=['{"text":"COMMON | FEET | Level II / III","color":"gray","italic":false}','{"text":"Increases movement speed.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:fleetfoot":3}},lore=['{"text":"COMMON | FEET | Level III / III","color":"gray","italic":false}','{"text":"Increases movement speed.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Fleetfoot I (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Fleetfoot II (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Fleetfoot III (common).","color":"gray"}
