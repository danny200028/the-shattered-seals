# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:titans_resolve":1}},lore=['{"text":"LEGENDARY | CHEST | Level I / III","color":"gold","italic":false}','{"text":"Provides substantial incoming damage protection.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:titans_resolve":2}},lore=['{"text":"LEGENDARY | CHEST | Level II / III","color":"gold","italic":false}','{"text":"Provides substantial incoming damage protection.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:titans_resolve":3}},lore=['{"text":"LEGENDARY | CHEST | Level III / III","color":"gold","italic":false}','{"text":"Provides substantial incoming damage protection.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Titan's Resolve I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Titan's Resolve II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Titan's Resolve III (legendary).","color":"gold"}
