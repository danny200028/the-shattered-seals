# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:aqua_step":1}},lore=['{"text":"COMMON | FEET | Level I / III","color":"gray","italic":false}','{"text":"Improves movement efficiency in water.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:aqua_step":2}},lore=['{"text":"COMMON | FEET | Level II / III","color":"gray","italic":false}','{"text":"Improves movement efficiency in water.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:aqua_step":3}},lore=['{"text":"COMMON | FEET | Level III / III","color":"gray","italic":false}','{"text":"Improves movement efficiency in water.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Aqua Step I (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Aqua Step II (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Aqua Step III (common).","color":"gray"}
