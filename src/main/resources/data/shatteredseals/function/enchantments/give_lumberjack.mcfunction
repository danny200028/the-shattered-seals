# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:lumberjack":1}},lore=['{"text":"COMMON | AXE | Level I / III","color":"gray","italic":false}','{"text":"Improves chopping speed with an axe.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:lumberjack":2}},lore=['{"text":"COMMON | AXE | Level II / III","color":"gray","italic":false}','{"text":"Improves chopping speed with an axe.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:lumberjack":3}},lore=['{"text":"COMMON | AXE | Level III / III","color":"gray","italic":false}','{"text":"Improves chopping speed with an axe.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Lumberjack I (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Lumberjack II (common).","color":"gray"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Lumberjack III (common).","color":"gray"}
