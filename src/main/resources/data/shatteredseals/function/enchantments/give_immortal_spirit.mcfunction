# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:immortal_spirit":1}},lore=['{"text":"LEGENDARY | ARMOR | Level I / III","color":"gold","italic":false}','{"text":"Raises maximum health while equipped.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:immortal_spirit":2}},lore=['{"text":"LEGENDARY | ARMOR | Level II / III","color":"gold","italic":false}','{"text":"Raises maximum health while equipped.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:immortal_spirit":3}},lore=['{"text":"LEGENDARY | ARMOR | Level III / III","color":"gold","italic":false}','{"text":"Raises maximum health while equipped.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Immortal Spirit I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Immortal Spirit II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Immortal Spirit III (legendary).","color":"gold"}
