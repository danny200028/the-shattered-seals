# Purchase-only weighted rank: I 65%, II 25%, III 10%. Direct give defaults to I.
execute unless score @s ss_ebook_rank matches 66..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:infernal_wrath":1}},lore=['{"text":"LEGENDARY | WEAPON | Level I / III","color":"gold","italic":false}','{"text":"Sometimes ignites enemies struck by the weapon.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach II and III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 66..90 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:infernal_wrath":2}},lore=['{"text":"LEGENDARY | WEAPON | Level II / III","color":"gold","italic":false}','{"text":"Sometimes ignites enemies struck by the weapon.","color":"gray","italic":false}','{"text":"Combine matching books in an anvil to reach III.","color":"dark_gray","italic":false}']] 1
execute if score @s ss_ebook_rank matches 91..100 run give @s minecraft:enchanted_book[stored_enchantments={levels:{"shatteredseals:infernal_wrath":3}},lore=['{"text":"LEGENDARY | WEAPON | Level III / III","color":"gold","italic":false}','{"text":"Sometimes ignites enemies struck by the weapon.","color":"gray","italic":false}','{"text":"Maximum enchantment level reached.","color":"dark_gray","italic":false}']] 1
execute unless score @s ss_ebook_rank matches 66..100 run tellraw @s {"text":"Purchased Infernal Wrath I (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 66..90 run tellraw @s {"text":"Purchased Infernal Wrath II (legendary).","color":"gold"}
execute if score @s ss_ebook_rank matches 91..100 run tellraw @s {"text":"Purchased Infernal Wrath III (legendary).","color":"gold"}
